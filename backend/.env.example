# ── VEYRA backend — environment variables ────────────────────────────────────
# Copy to `.env` for local use (the app does not auto-load .env; export the
# variables in your shell, or set them in the Render dashboard).
# No secrets are required by this service.

# Comma-separated list of browser origins allowed to call /api/*.
# Production default (when unset): https://veyra.rf.gd
# Add local dev origins only on your machine, e.g.:
# ALLOWED_ORIGINS=https://veyra.rf.gd,http://localhost:5173
ALLOWED_ORIGINS=https://veyra.rf.gd

# Port to listen on. Render sets this automatically — do NOT set it on Render.
# PORT=5000

# Directory where history.json is written (questions.json is copied there too).
# Default: the backend folder. On Render, set this to a persistent-disk mount
# (e.g. /var/data) if you attach a disk; otherwise leave unset.
# HISTORY_DIR=/var/data

# How long an unfinished quiz session stays valid (seconds). Default 7200 (2 h).
# SESSION_TTL_SECONDS=7200

# Gunicorn threads in the single worker. Default 8.
# WEB_THREADS=8

# Python logging level: DEBUG, INFO, WARNING, ERROR. Default INFO.
# LOG_LEVEL=INFO
